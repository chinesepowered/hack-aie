# Meta Model API (Muse + SAM 3.1) - https://ai.developer.meta.com
MODEL_API_KEY=
# Gemini API (Gemini 4 Argon + Nano Banana 2.1) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stripe TEST mode keys (optional; without them payments run in clearly-labelled demo mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Fetch.ai / Agentverse (optional; without it, connect via the inspector link printed at startup)
AGENTVERSE_API_KEY=
# Unique seed phrases for your agents (anything secret and unique)
BROKER_SEED=
APPRAISER_SEED=

# Public HTTPS URL for this server (e.g. from `cloudflared tunnel --url http://localhost:8787`).
# Used for item photos inside ASI:One cards and for phone camera access.
PUBLIC_BASE_URL=

# Only needed to render the demo video narration
ELEVENLABS_API_KEY=
